# ================================================================
#  🎲 LOTOFÁCIL PLATFORM - VARIÁVEIS DE AMBIENTE
#  Copie este arquivo como .env e preencha os valores
# ================================================================

# 🔑 Senha do PostgreSQL (altere para uma senha segura!)
POSTGRES_PASSWORD=password

# 🌐 Domínio do site (deixe vazio para usar IP direto)
# Exemplo: DOMAIN=loteria.seusite.com
DOMAIN=

# ================================================================
#  Variáveis abaixo são opcionais (valores padrão já configurados)
# ================================================================

# Porta do servidor web (padrão: 3000)
# PORT=3000

# URL do AI Engine (padrão: http://ai-engine:8000)
# No Docker Compose, o nome do serviço é o hostname
# AI_ENGINE_URL=http://ai-engine:8000

# Ambiente Node.js
# NODE_ENV=production
