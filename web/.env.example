# ==================== POSTGRES (NEON) ====================
# Connection string do Neon — USE A "Pooled connection string"
# (hostname termina em -pooler.neon.tech). O Neon EXIGE SSL (sslmode=require).
# Ex: postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ==================== SEGURANÇA ====================
# Secret das sessões (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Secret do Cron (o Vercel envia no header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# URL pública do site (usada nos links de compartilhamento)
SITE_URL=

# ==================== OPCIONAIS ====================
# Força cookie seguro (HTTPS). No Vercel já é ativado automaticamente.
COOKIE_SECURE=true
# APENAS para desenvolvimento local com Postgres sem SSL (ex: Docker local).
# NÃO configure no Vercel/Neon — o Neon exige SSL.
# PGSSL=false

# ==================== PIX (RECEBIMENTO DE DEPÓSITOS) ====================
# O app gera QR Codes PIX estáticos (BR Code) para os depósitos e o ADMIN
# confirma manualmente o recebimento antes de creditar o saldo (modelo
# whodo-next). Configure a chave PIX da empresa que RECEBE os depósitos:
PIX_KEY=67229517000128
# Nome do recebedor no payload PIX (máx. 25 caracteres)
PIX_NAME=Lotofacil Platform
# Cidade do recebedor no payload PIX (máx. 15 caracteres)
PIX_CITY=SAO PAULO
# Em testes (CI/local) desative a chamada externa ao gerador de imagem QR
# (a cobrança continua válida — só sem a imagem base64).
# PIX_QR_DISABLED=1
