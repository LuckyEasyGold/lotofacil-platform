  .bet-slip-total { margin-left: auto; text-align: right; }
  .bet-slip-btn { flex-shrink: 0; padding: 12px 22px; }
  /* Espaço extra no fim da página para o bilhete não cobrir o resumo */
  body.has-betslip .page-content { padding-bottom: 140px; }
}
</style>
