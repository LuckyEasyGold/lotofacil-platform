<% let body = `
<div class="stats-grid">
  <div class="stat-card primary">
    <div class="stat-icon"><i class="fas fa-brain"></i></div>
    <div class="stat-label">Status da IA</div>
    <div class="stat-value" style="font-size:22px;color:var(--primary-light)" id="aiStatus">🔄 Conectando...</div>
  </div>
  <div class="stat-card success">
    <div class="stat-icon"><i class="fas fa-dice-d6"></i></div>
    <div class="stat-label">Jogos Analisados</div>
    <div class="stat-value gradient" id="aiGamesAnalyzed">50</div>
  </div>
  <div class="stat-card info">
    <div class="stat-icon"><i class="fas fa-microchip"></i></div>
    <div class="stat-label">Versão da Semente</div>
    <div class="stat-value" style="font-size:20px;color:#60A5FA" id="aiVersion">-</div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">🧠 Jogos Gerados pela IA</div>
        <div class="card-subtitle">Baseado em análise estatística de resultados históricos</div>
      </div>
      <button class="btn btn-primary btn-sm" onclick="generateAIGames()">
        <i class="fas fa-sync"></i> Gerar Novos
      </button>
    </div>
    <div id="aiGamesList">
      <div class="empty-state">
        <i class="fas fa-robot"></i>
        <h3>Clique em "Gerar Novos"</h3>
        <p>A IA vai analisar padrões e sugerir jogos otimizados</p>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <div class="card-title">📊 Simulador de Resultados</div>
        <div class="card-subtitle">Teste seus números contra os últimos 50 concursos</div>
      </div>
    </div>
    <p style="font-size:14px;color:var(--text-secondary);margin-bottom:16px;">
      Selecione 15 números e veja como eles se sairiam nos últimos concursos.
    </p>
    <div class="numbers-grid" style="grid-template-columns:repeat(5,1fr);gap:8px;" id="simNumbersGrid">
      ${Array.from({length: 25}, (_, idx) => { const n = idx + 1; return '<button type="button" class="number-btn" style="font-size:16px;" data-sim-num="' + n + '" onclick="toggleSimNumber(this, ' + n + ')">' + n + '</button>'; }).join('')}
    </div>
    <div class="flex-between mt-1">
      <span style="font-size:13px;color:var(--text-secondary);">Selecionados: <strong id="simSelectedCount">0</strong>/15</span>
      <button class="btn btn-secondary btn-sm" onclick="clearSimNumbers()">Limpar</button>
    </div>
    <button class="btn btn-primary btn-full mt-2" onclick="runSimulation()">
      <i class="fas fa-play"></i> Simular
    </button>
    <div id="simResult" class="hidden mt-2"></div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header">
    <div>
      <div class="card-title">🔬 Análise Estatística da IA</div>
      <div class="card-subtitle">Padrões identificados pela inteligência artificial</div>
    </div>
  </div>
  <div id="aiAnalysis">
    <div class="empty-state">
      <i class="fas fa-chart-line"></i>
      <h3>Gerando análise...</h3>
      <p>Clique em "Gerar Novos" para ver a análise detalhada</p>
    </div>
  </div>
</div>

<script>
let simSelectedNumbers = new Set();
let aiGamesCache = [];

document.addEventListener('DOMContentLoaded', async () => {
  try {
    const seed = await api.getAISeed();
    if (seed && seed.status !== 'mock') {
      document.getElementById('aiStatus').innerHTML = '🟢 Online · v' + seed.version;
      document.getElementById('aiVersion').textContent = 'v' + seed.version;
    } else {
      document.getElementById('aiStatus').innerHTML = '🟡 Modo local <span style="font-size:12px;font-weight:400;">(engine Python desconectada)</span>';
      document.getElementById('aiVersion').textContent = 'v1.0.local';
    }
  } catch(e) {
    document.getElementById('aiStatus').innerHTML = '🟡 Modo local';
    document.getElementById('aiVersion').textContent = 'v1.0.local';
  }
});

function toggleSimNumber(btn, num) {
  if (simSelectedNumbers.has(num)) { simSelectedNumbers.delete(num); btn.classList.remove('selected'); }
  else if (simSelectedNumbers.size < 15) { simSelectedNumbers.add(num); btn.classList.add('selected'); }
  document.getElementById('simSelectedCount').textContent = simSelectedNumbers.size;
}
function clearSimNumbers() {
  simSelectedNumbers.clear();
  document.querySelectorAll('[data-sim-num]').forEach(b => b.classList.remove('selected'));
  document.getElementById('simSelectedCount').textContent = '0';
  document.getElementById('simResult').classList.add('hidden');
}

async function generateAIGames() {
  const btn = document.querySelector('.card .btn-primary .btn-sm');
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Gerando...';
  btn.disabled = true;
  try {
    const result = await api.generateAIGames('LOTOFACIL', 5);
    aiGamesCache = result.games || [];
    const container = document.getElementById('aiGamesList');
    container.innerHTML = result.games.map((game, idx) =>
      '<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--bg-input);border-radius:12px;margin-bottom:8px;">' +
      '<div style="display:flex;align-items:center;gap:12px;">' +
      '<span style="width:28px;height:28px;background:var(--gradient-primary);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:white;">' + (idx + 1) + '</span>' +
      '<div class="balls" style="gap:4px;">' + game.map(n => '<span class="ball primary" style="width:28px;height:28px;font-size:11px;">' + n + '</span>').join('') + '</div></div>' +
      '<div style="display:flex;gap:4px;">' +
      '<button class="btn btn-secondary btn-sm" onclick="useThisGame(' + JSON.stringify(game) + ')"><i class="fas fa-check"></i></button>' +
      '<button class="btn btn-primary btn-sm" onclick="saveGameToPortfolio(' + JSON.stringify(game) + ', \'' + (result.seed_version || '1.0') + '\')"><i class="fas fa-save"></i></button></div></div>'
    ).join('') +
    '<div style="margin-top:12px;padding:12px;background:rgba(16,185,129,0.1);border-radius:10px;"><span style="font-size:13px;color:var(--secondary);"><i class="fas fa-robot"></i> Gerado com seed ' + (result.seed_version || '1.0') + '</span></div>';
    generateAnalysis();
    showToast('🧠 5 jogos gerados pela IA!', 'success');
  } catch(e) { showToast('Erro ao gerar jogos com IA', 'error'); }
  btn.innerHTML = '<i class="fas fa-sync"></i> Gerar Novos';
  btn.disabled = false;
}

function useThisGame(game) {
  clearSimNumbers();
  game.forEach(n => { simSelectedNumbers.add(n); const btn = document.querySelector('[data-sim-num="' + n + '"]'); if (btn) btn.classList.add('selected'); });
  document.getElementById('simSelectedCount').textContent = 15;
  showToast('Números carregados! Clique em "Simular" para testar.', 'info');
}

async function saveGameToPortfolio(game, seedVersion) {
  try {
    // Get current count for naming
    let currentCount = 0;
    try {
      const stats = await api.getGameStats();
      currentCount = stats.total || 0;
    } catch(e) {}
    const name = 'IA #' + (currentCount + 1);
    const result = await api.saveGame(game, {
      name: name,
      source: 'ai',
      seedVersion: seedVersion || '1.0'
    });
    if (result.success) {
      showToast('💾 Jogo salvo no portfólio!', 'success');
    }
  } catch(e) {
    showToast('Erro ao salvar jogo', 'error');
  }
}

async function runSimulation() {
  if (simSelectedNumbers.size !== 15) return showToast('Selecione exatamente 15 números', 'error');
  const numbers = [...simSelectedNumbers].sort((a,b) => a-b);
  const btn = document.querySelector('.btn-primary.btn-full');
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Simulando...';
  btn.disabled = true;
  try {
    const result = await api.simulate(numbers);
    const container = document.getElementById('simResult');
    container.classList.remove('hidden');
    const hitRateClass = result.totalHits >= 10 ? 'success' : result.totalHits >= 5 ? 'accent' : 'info';
    container.innerHTML =
      '<div style="background:var(--bg-input);border-radius:16px;padding:24px;margin-top:16px;">' +
      '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px;">' +
      '<div style="text-align:center;"><div style="font-size:28px;font-weight:700;color:var(--' + hitRateClass + ');">' + result.bestHit + '</div><div style="font-size:12px;color:var(--text-muted);">Melhor Pontuação</div></div>' +
      '<div style="text-align:center;"><div style="font-size:28px;font-weight:700;color:var(--secondary);">' + (result.totalPrize || 0).toFixed(2).replace('.',',') + '</div><div style="font-size:12px;color:var(--text-muted);">Prêmio Total</div></div>' +
      '<div style="text-align:center;"><div style="font-size:28px;font-weight:700;color:var(--primary-light);">' + result.hitRate + '%</div><div style="font-size:12px;color:var(--text-muted);">Taxa de Acertos</div></div></div>' +
      '<div style="font-size:13px;color:var(--text-secondary);background:var(--bg-card);border-radius:10px;padding:12px;margin-bottom:12px;"><i class="fas fa-info-circle" style="color:var(--primary-light)"></i> ' +
      (result.bestHit >= 15 ? '🌟 PERFEITO! 15 acertos!' : result.bestHit >= 14 ? '🎯 Excelente! Quase fechou!' : result.bestHit >= 13 ? '💪 Muito bom!' : result.bestHit >= 11 ? '👍 Bom! Você teria premiação.' : '📊 Continue tentando!') + '</div>' +
      '<div style="max-height:200px;overflow-y:auto;"><table style="width:100%;font-size:13px;"><thead><tr><th>Concurso</th><th>Acertos</th><th>Prêmio</th></tr></thead><tbody>' +
      (result.results || []).slice(0, 20).map(r => '<tr><td>' + r.contestNumber + '</td><td><strong>' + r.hits + '</strong>' + (r.hits >= 11 ? ' 🎉' : '') + '</td><td>' + (r.prize > 0 ? '<span style="color:var(--secondary)">R$ ' + r.prize.toFixed(2).replace('.',',') + '</span>' : '-') + '</td></tr>').join('') +
      '</tbody></table></div></div>';
    showToast('Simulação concluída! Melhor: ' + result.bestHit + ' acertos', 'info');
  } catch(e) { showToast('Erro na simulação', 'error'); }
  btn.innerHTML = '<i class="fas fa-play"></i> Simular';
  btn.disabled = false;
}

function generateAnalysis() {
  const container = document.getElementById('aiAnalysis');
  const nums = aiGamesCache.length > 0 ? aiGamesCache[0] : [];
  if (nums.length === 0) { container.innerHTML = '<div class="empty-state"><i class="fas fa-chart-line"></i><h3>Sem dados para análise</h3></div>'; return; }
  const evens = nums.filter(n => n % 2 === 0).length;
  const odds = 15 - evens;
  const sum = nums.reduce((a,b) => a+b, 0);
  const primes = nums.filter(n => [2,3,5,7,11,13,17,19,23].includes(n)).length;
  container.innerHTML =
    '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;">' +
    '<div style="background:var(--bg-input);border-radius:12px;padding:20px;"><div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">📊 Paridade</div>' +
    '<div style="display:flex;gap:12px;align-items:center;"><div style="flex:1;height:8px;background:var(--bg-card);border-radius:4px;overflow:hidden;"><div style="height:100%;width:' + (evens/15*100) + '%;background:var(--gradient-primary);border-radius:4px;"></div></div><span style="font-weight:600;font-size:14px;">' + evens + 'P / ' + odds + 'I</span></div></div>' +
    '<div style="background:var(--bg-input);border-radius:12px;padding:20px;"><div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">🔢 Soma Total</div><div style="font-size:24px;font-weight:700;">' + sum + '</div><div style="font-size:12px;color:var(--text-muted);margin-top:4px;">Média: ' + (sum/15).toFixed(1) + '</div></div>' +
    '<div style="background:var(--bg-input);border-radius:12px;padding:20px;"><div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">🔵 Números Primos</div><div style="font-size:24px;font-weight:700;color:var(--accent);">' + primes + '</div><div style="font-size:12px;color:var(--text-muted);margin-top:4px;">de 15 números</div></div>' +
    '<div style="background:var(--bg-input);border-radius:12px;padding:20px;"><div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">📈 Distribuição</div><div style="font-size:24px;font-weight:700;color:var(--secondary);">' + (nums.filter(n => n <= 12).length) + '/' + (nums.filter(n => n > 12).length) + '</div><div style="font-size:12px;color:var(--text-muted);margin-top:4px;">Baixos / Altos</div></div></div>' +
    '<div style="margin-top:20px;padding:16px;background:linear-gradient(135deg,rgba(79,70,229,0.08),rgba(124,58,237,0.08));border:1px solid rgba(79,70,229,0.2);border-radius:12px;">' +
    '<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;"><i class="fas fa-lightbulb" style="color:var(--accent)"></i><span style="font-weight:600;">Recomendação da IA</span></div>' +
    '<p style="font-size:14px;color:var(--text-secondary);line-height:1.6;">' +
    (evens >= 6 && evens <= 9 ? '✅ ' : '⚠️ ') + (evens >= 6 && evens <= 9 ? 'Bom equilíbrio entre pares e ímpares. ' : 'Tente ajustar para ter entre 7 e 8 números pares. ') +
    (sum >= 180 && sum <= 220 ? '✅ Soma dentro da faixa ideal (180-220). ' : '⚠️ A soma ideal para Lotofácil fica entre 180 e 220. ') +
    'Mantenha uma distribuição uniforme no volante.</p></div>';
}
</script>
<style>
@media (max-width: 768px) {
  div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr !important; }
}
</style>
` %>
<%- include('layout', { body: body, title: 'Simulação com IA', page: 'simulation', user: user, subtitle: 'Use inteligência artificial para analisar seus jogos' }) %>
