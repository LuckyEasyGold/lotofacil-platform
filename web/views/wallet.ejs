<% const _fmt = (v) => (Number(v) || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
<% let body = `
<!-- Balance Cards -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:32px;">
  <div class="card" style="position:relative;overflow:hidden;">
    <div style="position:absolute;top:0;right:0;width:120px;height:120px;border-radius:0 0 0 100%;background:var(--gradient-primary);opacity:0.08;"></div>
    <div style="width:56px;height:56px;border-radius:14px;background:rgba(79,70,229,0.15);display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--primary-light);margin-bottom:20px;">
      <i class="fas fa-wallet"></i>
    </div>
    <div style="font-size:14px;color:var(--text-muted);margin-bottom:8px;">Saldo Principal</div>
    <div style="font-size:32px;font-weight:700;background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;" id="walletBalance">R$ ${_fmt(user?.balance)}</div>
    <div style="display:flex;gap:12px;margin-top:16px;">
      <button class="btn btn-primary btn-sm" onclick="openDepositModal()" style="flex:1;"><i class="fas fa-arrow-down"></i> Depositar</button>
      <button class="btn btn-secondary btn-sm" onclick="openWithdrawModal()" style="flex:1;"><i class="fas fa-arrow-up"></i> Sacar</button>
    </div>
  </div>
  <div class="card" style="position:relative;overflow:hidden;">
    <div style="position:absolute;top:0;right:0;width:120px;height:120px;border-radius:0 0 0 100%;background:var(--gradient-accent);opacity:0.08;"></div>
    <div style="width:56px;height:56px;border-radius:14px;background:rgba(245,158,11,0.15);display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--accent);margin-bottom:20px;">
      <i class="fas fa-gift"></i>
    </div>
    <div style="font-size:14px;color:var(--text-muted);margin-bottom:8px;">Bônus</div>
    <div style="font-size:32px;font-weight:700;color:var(--accent);" id="walletBonus">R$ ${_fmt(user?.bonusBalance)}</div>
    <div style="font-size:13px;color:var(--text-muted);margin-top:8px;">Bônus de boas-vindas</div>
  </div>
  <div class="card" style="position:relative;overflow:hidden;">
    <div style="position:absolute;top:0;right:0;width:120px;height:120px;border-radius:0 0 0 100%;background:var(--gradient-secondary);opacity:0.08;"></div>
    <div style="width:56px;height:56px;border-radius:14px;background:rgba(16,185,129,0.15);display:flex;align-items:center;justify-content:center;font-size:24px;color:var(--secondary);margin-bottom:20px;">
      <i class="fas fa-trophy"></i>
    </div>
    <div style="font-size:14px;color:var(--text-muted);margin-bottom:8px;">Total em Prêmios</div>
    <div style="font-size:32px;font-weight:700;color:var(--secondary);" id="walletPrizes">R$ ${_fmt(user?.totalWinnings)}</div>
    <div style="font-size:13px;color:var(--text-muted);margin-top:8px;">Prêmios recebidos</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:32px;">
  <div class="card" style="text-align:center;cursor:pointer;padding:24px;" onclick="openDepositModal()">
    <i class="fas fa-arrow-down" style="font-size:28px;color:var(--secondary);margin-bottom:12px;display:block;"></i>
    <span style="font-size:14px;font-weight:500;color:var(--text-secondary);">Depositar</span>
  </div>
  <div class="card" style="text-align:center;cursor:pointer;padding:24px;" onclick="openWithdrawModal()">
    <i class="fas fa-arrow-up" style="font-size:28px;color:var(--accent);margin-bottom:12px;display:block;"></i>
    <span style="font-size:14px;font-weight:500;color:var(--text-secondary);">Sacar</span>
  </div>
  <div class="card" style="text-align:center;cursor:pointer;padding:24px;" onclick="showNotification('Transferência', 'Em breve você poderá transferir saldo entre usuários da plataforma.', 'info')">
    <i class="fas fa-exchange-alt" style="font-size:28px;color:var(--primary-light);margin-bottom:12px;display:block;"></i>
    <span style="font-size:14px;font-weight:500;color:var(--text-secondary);">Transferir</span>
  </div>
  <div class="card" style="text-align:center;cursor:pointer;padding:24px;">
    <i class="fas fa-history" style="font-size:28px;color:var(--text-secondary);margin-bottom:12px;display:block;"></i>
    <span style="font-size:14px;font-weight:500;color:var(--text-secondary);">Extrato</span>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title">📋 Histórico de Transações</div>
      <div class="card-subtitle">Todas as movimentações da sua conta</div>
    </div>
    <select class="filter-select" onchange="filterTransactions(this.value)" style="padding:10px 16px;background:var(--bg-input);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:14px;">
      <option value="all">Todas</option>
      <option value="deposit">Depósitos</option>
      <option value="withdrawal">Saques</option>
      <option value="bet">Apostas</option>
      <option value="prize">Prêmios</option>
    </select>
  </div>
  <div class="table-container">
    <table>
      <thead>
        <tr><th>Tipo</th><th>Descrição</th><th>Data</th><th style="text-align:right">Valor</th><th>Status</th></tr>
      </thead>
      <tbody id="walletTransactions"></tbody>
    </table>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  await loadTransactions();
});

async function loadTransactions(filter = 'all') {
  try {
    const data = await api.getWallet();
    const tbody = document.getElementById('walletTransactions');
    
    let txns = data.transactions || [];
    if (filter !== 'all') txns = txns.filter(t => t.type === filter);
    
    if (txns.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:40px;">Nenhuma transação encontrada</td></tr>';
      return;
    }
    
    const typeIcons = { deposit: 'fa-arrow-down', bet: 'fa-ticket-alt', prize: 'fa-trophy', withdrawal: 'fa-arrow-up', share_sale: 'fa-handshake', pool_join: 'fa-users' };
    const typeLabels = { deposit: 'Depósito', bet: 'Aposta', prize: 'Prêmio', withdrawal: 'Saque', share_sale: 'Venda Cota', pool_join: 'Bolão' };
    
    tbody.innerHTML = txns.map(t => {
      const isPositive = t.amount > 0;
      return '<tr>' +
        '<td><i class="fas ' + (typeIcons[t.type] || 'fa-circle') + '" style="color:' + (isPositive ? 'var(--secondary)' : 'var(--danger)') + ';margin-right:8px;"></i> ' + (typeLabels[t.type] || t.type) + '</td>' +
        '<td style="color:var(--text)">' + t.description + '</td>' +
        '<td>' + new Date(t.date).toLocaleDateString('pt-BR') + '</td>' +
        '<td style="text-align:right;font-weight:700;color:' + (isPositive ? 'var(--secondary)' : 'var(--danger)') + '">' + (isPositive ? '+' : '') + formatCurrency(Math.abs(t.amount)) + '</td>' +
        '<td><span class="status-badge ' + t.status + '">' + (t.status === 'completed' ? 'Concluído' : t.status === 'pending' ? 'Pendente' : t.status) + '</span></td>' +
        '</tr>';
    }).join('');
  } catch(e) {
    document.getElementById('walletTransactions').innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:40px;">Erro ao carregar transações</td></tr>';
  }
}

function filterTransactions(filter) { loadTransactions(filter); }
function openDepositModal() {
  openModal('💰 Depósito', 'Adicione saldo à sua carteira',
    '<div class="form-group"><label>Valor do Depósito</label><div class="form-input"><input type="number" id="depositAmount" placeholder="Ex: 100,00" step="0.01" min="1"></div></div>' +
    '<div class="form-group"><label>Método</label><div class="form-input"><select id="depositMethod"><option value="PIX">PIX (Instantâneo)</option><option value="Boleto">Boleto Bancário</option><option value="Cartão">Cartão de Crédito</option></select></div></div>' +
    '<div style="background:var(--bg-input);border-radius:10px;padding:12px;margin-bottom:16px;font-size:13px;color:var(--text-secondary);">' +
    '<i class="fas fa-info-circle" style="color:var(--primary-light)"></i> Depósitos via PIX são creditados instantaneamente.</div>' +
    '<button class="btn btn-success btn-full" onclick="doDeposit()"><i class="fas fa-check"></i> Confirmar Depósito</button>'
  );
}
function openWithdrawModal() {
  openModal('💸 Saque', 'Transfira seu saldo para sua conta bancária',
    '<div class="form-group"><label>Valor do Saque</label><div class="form-input"><input type="number" id="withdrawAmount" placeholder="Ex: 50,00" step="0.01" min="1"></div></div>' +
    '<div class="form-group"><label>Banco</label><div class="form-input"><select id="withdrawBank"><option value="nubank">Nubank</option><option value="itau">Itaú</option><option value="bradesco">Bradesco</option><option value="santander">Santander</option><option value="bb">Banco do Brasil</option><option value="caixa">Caixa</option></select></div></div>' +
    '<div class="form-group"><label>Agência</label><div class="form-input"><input type="text" id="withdrawAgency" placeholder="0000"></div></div>' +
    '<div class="form-group"><label>Conta</label><div class="form-input"><input type="text" id="withdrawAccount" placeholder="00000-0"></div></div>' +
    '<div style="background:var(--bg-input);border-radius:10px;padding:12px;margin-bottom:16px;font-size:13px;color:var(--text-secondary);">' +
    '<i class="fas fa-clock" style="color:var(--accent)"></i> Saques são processados em até 2 dias úteis.</div>' +
    '<button class="btn btn-primary btn-full" onclick="doWithdraw()"><i class="fas fa-check"></i> Solicitar Saque</button>'
  );
}
async function doDeposit() {
  const amount = parseFloat(document.getElementById('depositAmount').value);
  const method = document.getElementById('depositMethod').value;
  if (!amount || amount <= 0) return showToast('Digite um valor válido', 'error');
  try {
    const result = await api.deposit(amount, method);
    if (result.success) {
      showToast(formatCurrency(amount) + ' depositados com sucesso!', 'success');
      closeModal();
      setTimeout(() => location.reload(), 1500);
    }
  } catch(e) { showToast('Erro ao depositar', 'error'); }
}
async function doWithdraw() {
  const amount = parseFloat(document.getElementById('withdrawAmount').value);
  if (!amount || amount <= 0) return showToast('Digite um valor válido', 'error');
  try {
    const result = await api.withdraw(amount);
    if (result.success) {
      showToast('Saque de ' + formatCurrency(amount) + ' solicitado!', 'success');
      closeModal();
      setTimeout(() => location.reload(), 1500);
    }
  } catch(e) { showToast(e.message || 'Erro ao sacar', 'error'); }
}
</script>
<style>
/* Seletores corrigidos: o CSS inline usa repeat(3,1fr) sem espacos;
   os seletores antigos pediam repeat(3,1fr) com espaco apos os dois
   pontos e nunca casavam — os 3/4 cards de saldo estouravam no mobile.
   Agora casam pela parte unica do valor. */
@media (max-width: 1024px) {
  div[style*="repeat(3,1fr)"] { grid-template-columns: 1fr !important; }
  div[style*="repeat(4,1fr)"] { grid-template-columns: repeat(2,1fr) !important; }
}
</style>
` %>
<%- include('layout', { body: body, title: 'Carteira', page: 'wallet', user: user, subtitle: 'Gerencie seu saldo e transações' }) %>
